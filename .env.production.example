APP_NAME="Dib 24x7 Events"
APP_ENV=production
APP_KEY=base64:FMyhQ4e/mkIK8mnYqRlNifAbr6Y9LRKINZv8kaxhFb0=
APP_DEBUG=false
APP_URL=https://digitalpilot.co.in/event-demo
ASSET_URL=https://digitalpilot.co.in/event-demo

# Optional: If separating core files into /home/username/events_core and public into /home/username/public_html/event-demo
# APP_PUBLIC_PATH=../public_html/event-demo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite database setup:
DB_CONNECTION=sqlite
# By default, Laravel resolves database/database.sqlite automatically.
# If needed, you can specify an absolute path:
# DB_DATABASE=/home/username/events_core/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
